        "allowed-values" : [ {
          "key" : "WholeImage"
        }, {
          "key" : "InsideRoi"
        }, {
          "key" : "OutsideRoi"
        }, {
          "key" : "InsideMask"
        }, {
          "key" : "OutsideMask"
        } ],
        "archetype" : "SingleSelect"
