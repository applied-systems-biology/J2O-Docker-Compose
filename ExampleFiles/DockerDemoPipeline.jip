              "hidden" : false,
              "field-class" : "java.lang.String",
              "value" : "",
              "short-key" : "name",
              "ui-order" : -95,
              "field-class-id" : "string"
            },
            "description" : {
              "key" : "description",
              "name" : "Description",
              "description" : "Description as displayed in the UI",
              "hidden" : false,
              "field-class" : "java.lang.String",
              "value" : "",
              "short-key" : "description",
              "ui-order" : -92,
              "field-class-id" : "string"
            },
            "key" : {
              "key" : "key",
              "name" : "Key",
              "description" : "The key that will be used to access the directory. Cannot be empty.",
              "hidden" : false,
              "field-class" : "java.lang.String",
              "value" : "",
              "short-key" : "key",
              "ui-order" : -100,
              "field-class-id" : "string"
            }
          }
        },
